# Mail Server Configuration
# IMPORTANT: These values must be obtained from the CRIS IT/network team.
# They are not public values. The CRIS internal relay server (e.g., mail.smtp.host)
# and credentials (if any) are required for the application to send DBA audit emails.
# Replace the placeholders with the actual values provided by the CRIS IT team.

CRIS_SMTP_HOST=10.77.32.48
CRIS_SMTP_PORT=25
CRIS_MAIL_USERNAME=freightcod@cris.org.in
CRIS_MAIL_PASSWORD=FCODE

# Oracle DB Configuration
# Use the connection values from the DB client and keep the password local only.
ORACLE_DB_URL=jdbc:oracle:thin:@//10.30.6.65:1521/test.crisexacc.org
ORACLE_DB_USERNAME=tms3t
ORACLE_DB_PASSWORD=tms3t
