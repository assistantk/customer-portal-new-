<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ─── Log directory: override with LOG_PATH env var or logging.file.path property ── -->
    <springProperty scope="context" name="LOG_PATH" source="logging.file.path" defaultValue="./logs"/>

    <!-- ─────────────────────────────────────────────────────────────────────────────────── -->
    <!-- APPENDERS                                                                           -->
    <!-- ─────────────────────────────────────────────────────────────────────────────────── -->

    <!-- Console: all levels, coloured in dev, plain in prod -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{requestId:-no-rid}] [%thread] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Rolling file: app.log — all levels, daily + 50 MB size roll, 30-day history, 1 GB cap -->
    <appender name="FILE_ALL" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/app.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{requestId:-no-rid}] [%thread] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Rolling file: error.log — ERROR only, daily + 50 MB size roll, 30-day history, 200 MB cap -->
    <appender name="FILE_ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{requestId:-no-rid}] [%thread] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ─────────────────────────────────────────────────────────────────────────────────── -->
    <!-- PROFILE: dev — DEBUG/TRACE, SQL bind values visible                                -->
    <!-- ─────────────────────────────────────────────────────────────────────────────────── -->
    <springProfile name="dev">
        <!-- Application code: DEBUG -->
        <logger name="com.cris.customerportal" level="DEBUG"/>
        <!-- Hibernate 5 SQL + bind parameters -->
        <logger name="org.hibernate.SQL"                                    level="DEBUG"/>
        <logger name="org.hibernate.type.descriptor.sql.BasicBinder"        level="TRACE"/>
        <!-- Spring Web / MVC -->
        <logger name="org.springframework.web"                              level="DEBUG"/>
        <logger name="org.springframework.web.servlet.DispatcherServlet"    level="DEBUG"/>
        <!-- Raw JDBC via DataSource -->
        <logger name="org.springframework.jdbc.core.JdbcTemplate"           level="DEBUG"/>
        <logger name="org.springframework.jdbc.core.StatementCreatorUtils"  level="TRACE"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE_ALL"/>
            <appender-ref ref="FILE_ERROR"/>
        </root>
    </springProfile>

    <!-- ─────────────────────────────────────────────────────────────────────────────────── -->
    <!-- PROFILE: prod — INFO only; SQL at DEBUG level but NO bind values                   -->
    <!-- ─────────────────────────────────────────────────────────────────────────────────── -->
    <springProfile name="prod">
        <!-- Application code: INFO -->
        <logger name="com.cris.customerportal" level="INFO"/>
        <!-- Hibernate 5: SQL query shapes only — bind values suppressed -->
        <logger name="org.hibernate.SQL"                                    level="DEBUG"/>
        <!-- org.hibernate.type.descriptor.sql.BasicBinder intentionally NOT set to TRACE in prod -->
        <!-- Spring noise suppressed in prod -->
        <logger name="org.springframework.web"                              level="WARN"/>
        <logger name="org.springframework.security"                         level="WARN"/>
        <!-- Raw JDBC query logging (no bind values at StatementCreatorUtils TRACE) -->
        <logger name="org.springframework.jdbc.core.JdbcTemplate"           level="DEBUG"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE_ALL"/>
            <appender-ref ref="FILE_ERROR"/>
        </root>
    </springProfile>

    <!-- ─────────────────────────────────────────────────────────────────────────────────── -->
    <!-- DEFAULT (no profile active / test / local without a profile flag)                  -->
    <!-- ─────────────────────────────────────────────────────────────────────────────────── -->
    <springProfile name="!dev &amp; !prod">
        <logger name="com.cris.customerportal" level="DEBUG"/>
        <logger name="org.hibernate.SQL"                                    level="DEBUG"/>
        <logger name="org.hibernate.type.descriptor.sql.BasicBinder"        level="TRACE"/>
        <logger name="org.springframework.jdbc.core.JdbcTemplate"           level="DEBUG"/>
        <logger name="org.springframework.jdbc.core.StatementCreatorUtils"  level="TRACE"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE_ALL"/>
            <appender-ref ref="FILE_ERROR"/>
        </root>
    </springProfile>

</configuration>

