# ==============================================================================
# CRIS Customer Registration Portal — Production Server Environment File
# Location on Server: /etc/customer-portal/customer-portal.env
# Permissions: chmod 0600 /etc/customer-portal/customer-portal.env
# Ownership:   chown root:portal /etc/customer-portal/customer-portal.env
#
# DO NOT COMMIT REAL PRODUCTION CREDENTIALS TO SOURCE CONTROL.
# ==============================================================================

# Oracle Database Connection (Provided by CRIS DBA)
ORACLE_DB_URL=jdbc:oracle:thin:@//<ORACLE_HOST>:<ORACLE_PORT>/<SERVICE_NAME>
ORACLE_DB_USERNAME=<DB_USER>
ORACLE_DB_PASSWORD=<DB_PASSWORD>

# CRIS Internal SMTP Relay Configuration (Provided by CRIS IT)
CRIS_SMTP_HOST=<SMTP_HOST>
CRIS_SMTP_PORT=25
CRIS_MAIL_USERNAME=<SMTP_USERNAME>
CRIS_MAIL_PASSWORD=<SMTP_PASSWORD>
DBA_EMAIL=<DBA_EMAIL_RECIPIENT>

# Application Specific Parameters
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
APP_UPLOAD_DIR=/var/portal-uploads

# JVM Memory Tuning (Optional)
# JAVA_OPTS="-Xms1024m -Xmx2048m -XX:+UseG1GC"
