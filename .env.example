# ====================================================================
# Example Environment Configuration for Freight Code Generator
# Copy this file to .env and replace the placeholders with actual values
# ====================================================================

# Mail Server Configuration (Provided by CRIS Network / IT team)
CRIS_SMTP_HOST=your-smtp-host.internal
CRIS_SMTP_PORT=25
CRIS_MAIL_USERNAME=your-username@cris.org.in
CRIS_MAIL_PASSWORD=your-mail-password

# Oracle DB Configuration (Target Oracle Database instance)
ORACLE_DB_URL=jdbc:oracle:thin:@//your-oracle-host:1521/your-service-name
ORACLE_DB_USERNAME=your-db-username
ORACLE_DB_PASSWORD=your-db-password

# Live RMS API endpoint. Live mode requires an approved TLS-enabled HTTPS endpoint.
RMS_API_BASE_URL=https://your-approved-rms-host/RMS

# Keep enabled in deployed environments. Set false only for local HTTP development.
REQUIRE_HTTPS=true
