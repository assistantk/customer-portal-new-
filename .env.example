# ==============================================================================
# Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' for local development:
#      cp .env.example .env
# 2. Never commit '.env' or any file containing real credentials to version control.
# 3. Supplying environment variables to Spring Boot:
#    - Via .env file: Loaded if spring.config.import=optional:file:.env[.properties] is present.
#    - Via PowerShell (recommended for direct terminal runs):
#        $env:ORACLE_DB_URL = "jdbc:oracle:thin:@//<host>:<port>/<service_name>"
#        $env:ORACLE_DB_USERNAME = "<username>"
#        $env:ORACLE_DB_PASSWORD = Read-Host "Oracle database password"
#        .\mvnw.cmd spring-boot:run
#    - Via Bash / Linux / macOS:
#        export ORACLE_DB_URL="jdbc:oracle:thin:@//<host>:<port>/<service_name>"
#        export ORACLE_DB_USERNAME="<username>"
#        export ORACLE_DB_PASSWORD="<password>"
#        ./mvnw spring-boot:run
# ==============================================================================

# Oracle Database Configuration (Required)
ORACLE_DB_URL=jdbc:oracle:thin:@//<host>:<port>/<service_name>
ORACLE_DB_USERNAME=your_db_username
ORACLE_DB_PASSWORD=your_db_password

# CRIS Mail Server Configuration (Optional / Internal Relay)
CRIS_SMTP_HOST=your_smtp_host
CRIS_SMTP_PORT=25
CRIS_MAIL_USERNAME=your_mail_username
CRIS_MAIL_PASSWORD=your_mail_password
DBA_EMAIL=dba_notification_recipient@example.com
